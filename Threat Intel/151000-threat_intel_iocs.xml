<!--
  Threat-intel IOC matching (rule IDs 151000-151049; Wazuh 4.14 ships its own 150100-150103).

  Uses CDB lists generated by tools/update_threat_intel.py from abuse.ch
  (Feodo Tracker, SSLBL, ThreatFox, URLhaus, MalwareBazaar), Spamhaus DROP
  and the CISA KEV catalog. The lists are refreshed weekly in this repo.
  Copy "Threat Intel/lists/*" (except SOURCES.md) to /var/ossec/etc/lists/
  and register each one in ossec.conf <ruleset>. See "Threat Intel/README.md".

  The matched list entry's value (source/threat/malware family) isn't added to
  the alert by Wazuh. Look the indicator up in the list file, or on
  threatfox.abuse.ch / urlhaus.abuse.ch, when triaging.
-->
<group name="threat_intel,ioc,">

  <!-- ===================== Windows endpoints (Sysmon) ===================== -->

  <rule id="151000" level="12">
    <if_group>sysmon_event3</if_group>
    <list field="win.eventdata.destinationIp" lookup="address_match_key">etc/lists/abusech-c2-ip</list>
    <description>Threat intel: $(win.eventdata.image) connected to known malware C2/hosting IP $(win.eventdata.destinationIp):$(win.eventdata.destinationPort) (abuse.ch)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <options>no_full_log</options>
    <group>c2,</group>
  </rule>

  <rule id="151001" level="10">
    <if_group>sysmon_event3</if_group>
    <list field="win.eventdata.destinationIp" lookup="address_match_key">etc/lists/spamhaus-drop</list>
    <description>Threat intel: $(win.eventdata.image) connected to Spamhaus DROP netblock $(win.eventdata.destinationIp) (hijacked or criminal-operated range)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <options>no_full_log</options>
    <group>c2,</group>
  </rule>

  <rule id="151002" level="12">
    <if_group>sysmon_event_22</if_group>
    <list field="win.eventdata.queryName" lookup="match_key">etc/lists/abusech-malicious-domain</list>
    <description>Threat intel: $(win.eventdata.image) resolved known malicious domain $(win.eventdata.queryName) (abuse.ch ThreatFox/URLhaus)</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
    <options>no_full_log</options>
    <group>c2,</group>
  </rule>

  <!-- ====================== Network sensors (Suricata) ====================== -->
  <!-- Children of Suricata/100002 (non-alert EVE events: flow, dns, tls, http). -->

  <rule id="151003" level="12">
    <if_sid>100002</if_sid>
    <list field="dest_ip" lookup="address_match_key">etc/lists/abusech-c2-ip</list>
    <description>Threat intel: $(src_ip) talked to known malware C2/hosting IP $(dest_ip):$(dest_port) ($(event_type), abuse.ch)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <options>no_full_log</options>
    <group>c2,</group>
  </rule>

  <rule id="151004" level="12">
    <if_sid>100002</if_sid>
    <field name="event_type">^dns$</field>
    <list field="dns.rrname" lookup="match_key">etc/lists/abusech-malicious-domain</list>
    <description>Threat intel: $(src_ip) looked up known malicious domain $(dns.rrname) (abuse.ch ThreatFox/URLhaus)</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
    <options>no_full_log</options>
    <group>c2,</group>
  </rule>

  <rule id="151005" level="12">
    <if_sid>100002</if_sid>
    <field name="event_type">^tls$</field>
    <list field="tls.sni" lookup="match_key">etc/lists/abusech-malicious-domain</list>
    <description>Threat intel: $(src_ip) opened TLS to known malicious domain $(tls.sni) at $(dest_ip)</description>
    <mitre>
      <id>T1071.001</id>
    </mitre>
    <options>no_full_log</options>
    <group>c2,</group>
  </rule>

  <rule id="151006" level="12">
    <if_sid>100002</if_sid>
    <field name="event_type">^http$</field>
    <list field="http.hostname" lookup="match_key">etc/lists/abusech-malicious-domain</list>
    <description>Threat intel: $(src_ip) made HTTP request to known malicious host $(http.hostname)$(http.url)</description>
    <mitre>
      <id>T1071.001</id>
    </mitre>
    <options>no_full_log</options>
    <group>c2,</group>
  </rule>

  <!-- ============================ Firewalls ============================ -->

  <rule id="151007" level="12">
    <if_group>firewall</if_group>
    <list field="dstip" lookup="address_match_key">etc/lists/abusech-c2-ip</list>
    <description>Threat intel: firewall saw $(srcip) connect to known malware C2/hosting IP $(dstip) (abuse.ch)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <group>c2,</group>
  </rule>

  <rule id="151008" level="10">
    <if_group>firewall</if_group>
    <list field="dstip" lookup="address_match_key">etc/lists/spamhaus-drop</list>
    <description>Threat intel: firewall saw $(srcip) connect to Spamhaus DROP netblock $(dstip)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <group>c2,</group>
  </rule>

  <!-- ======================= File integrity monitoring ======================= -->

  <rule id="151009" level="13">
    <if_group>syscheck</if_group>
    <list field="syscheck.sha256_after" lookup="match_key">etc/lists/abusech-malware-sha256</list>
    <description>Threat intel: known malware written to $(syscheck.path) (SHA256 $(syscheck.sha256_after) listed by abuse.ch)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>malware,</group>
  </rule>

  <!-- ===================== Vulnerability detection (KEV) ===================== -->
  <!-- Children of Wazuh's active-vulnerability rules 23503-23506 (Wazuh 4.8+). -->

  <rule id="151010" level="13">
    <if_sid>23503, 23504, 23505, 23506</if_sid>
    <list field="vulnerability.cve" lookup="match_key">etc/lists/cisa-kev-cve</list>
    <description>CISA KEV: $(vulnerability.cve) is exploited in the wild and affects $(vulnerability.package.name) $(vulnerability.package.version) on this agent. Prioritise patching.</description>
    <group>vulnerability-detector,cisa_kev,</group>
  </rule>

  <rule id="151011" level="14">
    <if_sid>151010</if_sid>
    <list field="vulnerability.cve" lookup="match_key_value" check_value="^Known$">etc/lists/cisa-kev-cve</list>
    <description>CISA KEV: $(vulnerability.cve) is used in ransomware campaigns and affects $(vulnerability.package.name) $(vulnerability.package.version) on this agent. Patch immediately.</description>
    <mitre>
      <id>T1486</id>
    </mitre>
    <group>vulnerability-detector,cisa_kev,ransomware,</group>
  </rule>

</group>
